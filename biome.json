{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"files": {
		"ignore": [
			"node_modules",
			"dist",
			"build",
			".next",
			"out",
			"apps/web/public/official-site",
			".turbo",
			".vercel",
			"coverage",
			".oneglanse-storage"
		]
	},
	"overrides": [
		{
			"include": ["apps/website/site/assets/**"],
			"formatter": { "enabled": false },
			"linter": {
				"rules": {
					"complexity": { "noForEach": "off" },
					"suspicious": { "noRedundantUseStrict": "off" }
				}
			}
		}
	]
}
