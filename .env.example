# Local defaults: docker-compose overrides these internally with container hostnames.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oneglanse
CLICKHOUSE_URL=http://localhost:8123
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# Optional public live dashboard: exposes current response/analysis summaries for
# this single workspace without login. Empty disables /api/public/dashboard.
# Set only to the workspace authorized for public display; no client override.
PUBLIC_DASHBOARD_WORKSPACE_ID=

# App mode: overridden automatically by pnpm local (forces "local") and docker-compose (forces "self-host")
ONEGLANSE_APP_MODE=local

# Docker service defaults used by `pnpm self-host`
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oneglanse
CLICKHOUSE_DB=oneglanse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# App secrets
# `pnpm local`, `pnpm auth`, and `pnpm self-host` auto-generate these when
# creating a fresh `.env` from this template.
BETTER_AUTH_SECRET=replace-me
INTERNAL_CRON_SECRET=replace-me

# Anonymous usage telemetry (PostHog). Disabled unless explicitly set to "true":
# leaving it unset keeps every deployment from contacting a third-party server.
TELEMETRY_ENABLED=false

# Google OAuth: required for Google sign-in to the OneGlanse web app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional. Defaults to gpt-5.6-sol, the model the project's analysis relay serves on
# its OpenRouter-shaped endpoint — set this explicitly for any other provider.
# The direct OpenAI API defaults to gpt-4.1; Claude defaults to claude-sonnet-4-6.
ANALYSIS_MODEL=
ANTHROPIC_API_KEY=
# Optional. Model for the three narrative report passes (executive summary, gap
# narratives, recommendations). Defaults to claude-fable-5-1.
REPORT_MODEL=
# Which LLM to use for response analysis: "openai" (default) or "claude"
ANALYSIS_LLM_PROVIDER=openai

# Android device automation (disabled until Appium diagnostics and app login checks pass)
ANDROID_DEVICE_AUTOMATION_ENABLED=false
# Generate with: openssl rand -base64 32
DEVICE_CONFIG_ENCRYPTION_KEY=
# Local Appium 2 endpoint. From Docker use http://host.docker.internal:4723.
LOCAL_APPIUM_URL=http://127.0.0.1:4723
# Shared screenshot storage; Docker Compose overrides this to /storage/artifacts.
AGENT_ARTIFACT_ROOT_DIR=

# Optional auth-session upload target used by `pnpm auth` / `pnpm upload:vps`
# If AGENT_AUTH_UPLOAD_URL is not set, the auth helper derives:
#   http://<ONEGLANSE_VPS_IP>:3333/auth/sessions
ONEGLANSE_VPS_IP=
AGENT_AUTH_UPLOAD_TOKEN=

# Proxy: required on VPS (direct connection is not permitted)
# OneGlanse uses ThorData residential proxies. Set your ThorData API endpoint below.
# THORDATA_PROXY_API_URL=
# PROXY_SCHEME=http
# Comma-separated providers that should bypass the VPS proxy.
# DIRECT_BROWSER_PROVIDERS=doubao,deepseek,kimi,yuanbao,qianwen,diandian
# Maximum number of provider browsers that may run at the same time.
# PROVIDER_EXECUTION_CONCURRENCY=1

# Optional agent/runtime overrides
# DEBUG_ENABLED=true
# CAMOUFOX_HEADLESS_MODE=virtual
# CAMOUFOX_PYTHON_BIN=
# CAMOUFOX_PIP_SPEC=cloverlabs-camoufox==0.5.5
# CAMOUFOX_BROWSER_CHANNEL=official/stable/135.0.1-beta.24

# Self-hosted storage root (volume mount path on the host)
ONEGLANSE_STORAGE_ROOT=/opt/oneglanse/storage

# Optional: override the published image names (e.g. when self-hosting a fork).
# Defaults point to the official prebuilt images published to GHCR on every release.
ONEGLANSE_AGENT_IMAGE=
ONEGLANSE_WEB_IMAGE=
ONEGLANSE_POSTGRES_IMAGE=
