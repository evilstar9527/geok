# syntax=docker/dockerfile:1.7

# Server-specific variant of apps/agent/Dockerfile for the Aliyun VPS, where the
# ~633 MB camoufox browser download from GitHub releases is unusably slow.
# Instead of `camoufox fetch`, it bakes in a pre-downloaded zip that must exist
# at the build-context root as `camoufox-lin.x86_64.zip` (git-ignored).
#
# Fetch it on the server with:
#   curl -sL -o camoufox-lin.x86_64.zip \
#     'https://ghfast.top/https://github.com/daijro/camoufox/releases/download/<ver>/camoufox-<ver>-lin.x86_64.zip'

FROM node:20-bookworm-slim AS base
WORKDIR /app
ARG PNPM_VERSION=10.16.0
RUN npm install -g pnpm@${PNPM_VERSION}

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json tsconfig.json ./
COPY apps/agent ./apps/agent
COPY packages/db ./packages/db
COPY packages/errors ./packages/errors
COPY packages/services ./packages/services
COPY packages/types ./packages/types
COPY packages/utils ./packages/utils

RUN --mount=type=cache,id=pnpm-store-agent,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS builder
RUN pnpm turbo build --filter=@oneglanse/agent...
RUN pnpm deploy --filter @oneglanse/agent --prod /app/out

FROM node:20-bookworm-slim AS runner
ARG PNPM_VERSION=10.16.0
ARG CAMOUFOX_PIP_SPEC
ARG CAMOUFOX_BROWSER_CHANNEL

# Aliyun mirrors: deb.debian.org and PyPI are unreliable from the VPS in China.
COPY camoufox-lin.x86_64.zip /tmp/camoufox-lin.x86_64.zip
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get update && apt-get install -y --no-install-recommends \
  python3 \
  python3-pip \
  libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
  libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
  libgbm1 libasound2 libpangocairo-1.0-0 libgtk-3-0 libdbus-glib-1-2 \
  libx11-xcb1 libxt6 \
  ca-certificates \
  fontconfig \
  xvfb \
  fonts-noto-core fonts-noto-extra fonts-noto-cjk fonts-noto-color-emoji \
  && fc-cache -f \
  && test -n "${CAMOUFOX_PIP_SPEC}" \
  && python3 -m pip install --no-cache-dir --break-system-packages \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    "${CAMOUFOX_PIP_SPEC}" \
  && mkdir -p /root/.cache/camoufox/browsers/official/152.0.4-beta.30 \
  && python3 -c "import zipfile; zipfile.ZipFile('/tmp/camoufox-lin.x86_64.zip').extractall('/root/.cache/camoufox/browsers/official/152.0.4-beta.30')" \
  && printf '%s' '{"version":"152.0.4","build":"beta.30","prerelease":true}' > /root/.cache/camoufox/browsers/official/152.0.4-beta.30/version.json \
  && printf '%s' '{"active_version":"browsers/official/152.0.4-beta.30"}' > /root/.cache/camoufox/config.json \
  && touch /root/.cache/camoufox/.0.5_FLAG \
  && chmod -R 755 /root/.cache/camoufox/browsers/official/152.0.4-beta.30 \
  && rm -f /tmp/camoufox-lin.x86_64.zip \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production
ENV CAMOUFOX_PYTHON_BIN=python3

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

COPY --from=builder /app/out ./
COPY apps/agent/docker/start-worker.sh /usr/local/bin/start-worker
RUN chmod +x /usr/local/bin/start-worker

RUN chown -R node:node /app

CMD ["/usr/local/bin/start-worker"]
